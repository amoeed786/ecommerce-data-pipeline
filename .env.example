# Copy this file to .env and adjust for your machine.
SQL_SERVER=localhost\MSSQLSERVER02
SQL_DATABASE=ShopDB
SQL_DRIVER=ODBC Driver 18 for SQL Server

# Where the admin area lives (sign-in page = ADMIN_PATH/login). Pick something hard to guess for real use,
# e.g. ADMIN_PATH=/kartora-control-7f3a91  - letters, digits, - and _ only. Restart the app after changing it.
ADMIN_PATH=/admin
