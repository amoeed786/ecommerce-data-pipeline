# Copy this file to .env and adjust for your machine.
SQL_SERVER=localhost\MSSQLSERVER02
SQL_DATABASE=ShopDB
SQL_DRIVER=ODBC Driver 18 for SQL Server

# Where the admin area lives (sign-in page = ADMIN_PATH/login). Pick something hard to guess for real use,
# e.g. ADMIN_PATH=/raunaqi-control-7f3a91  - letters, digits, - and _ only. Restart the app after changing it.
ADMIN_PATH=/admin

# Payments + seller payouts (all optional - these are the defaults)
PAYMENT_GATEWAY=sandbox          # built-in test gateway; a JazzCash/Easypaisa/bank adapter plugs in here later
PAYMENT_TIMEOUT_MINUTES=30       # unpaid online orders are cancelled (stock goes back) after this
PAYOUT_HOLD_DAYS=7               # return window: seller earnings are held this long after delivery
PAYOUT_MIN_AMOUNT=2500           # PKR - don't create payouts smaller than this

# Market (one country, one currency: PKR)
MARKET_COUNTRY=Pakistan
